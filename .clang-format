BasedOnStyle: Google
Language: Cpp
Standard: c++20
ColumnLimit: 100
IndentWidth: 4
DerivePointerAlignment: false
PointerAlignment: Left
SortIncludes: CaseSensitive
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<windows\.h>$'
    Priority: 3
  - Regex: '^<[^/]*\.h>$'
    Priority: 4
  - Regex: '^<[^.]*>$'
    Priority: 5
  - Regex: '.*'
    Priority: 6
BreakBeforeBraces: Custom
BraceWrapping:
  AfterFunction: true
